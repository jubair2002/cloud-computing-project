# Used by `docker compose up` to configure the backend, frontend, and AWS RDS
# connection. Copy this file to `.env` (same folder as docker-compose.yml)
# and replace the placeholder values before running Docker Compose:
#
#   cp .env.example .env
#
# This root .env is only read by Docker Compose — it's separate from
# back-end/.env and front-end/.env, which are used for native (non-Docker) dev.

# Host used in public URLs. Use `localhost` on your laptop. On EC2, set this
# to your instance's public IP (or domain) so browsers outside can reach the
# app when security-group ports are open. localhost on the EC2 box still works
# because the instance can reach its own public IP.
PUBLIC_HOST=localhost

BACKEND_PORT=8000
FRONTEND_PORT=5173

# AWS RDS (no MySQL container — connect directly to your RDS instance)
DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
DB_PORT=3306
DB_DATABASE=shophub
DB_USERNAME=shophub
DB_PASSWORD=change-me-db-password

# Optional: RDS SSL CA bundle path inside the backend container (leave empty if
# your RDS instance does not require SSL)
# MYSQL_ATTR_SSL_CA=/path/to/rds-ca.pem

# Backend defaults to APP_ENV=production / APP_DEBUG=false so a straight
# `docker compose up` never leaks stack traces. Uncomment for local debugging:
# APP_ENV=local
# APP_DEBUG=true

# When true, one-click demo login buttons appear on /admin/login and /login,
# and their credentials are published by the public /api/config endpoint —
# only enable this on throwaway demo deployments. DEMO_SANDBOX_CONFIRMED must
# ALSO be true, or credentials stay hidden even with DEMO_MODE=true — a
# deliberate second flag so this can't leak by accident on a real deployment.
DEMO_MODE=false
DEMO_SANDBOX_CONFIRMED=false
DEMO_ADMIN_EMAIL=admin@shophub.test
DEMO_ADMIN_PASSWORD=change-me-demo-password
DEMO_CUSTOMER_EMAIL=customer@shophub.test
DEMO_CUSTOMER_PASSWORD=change-me-demo-password
